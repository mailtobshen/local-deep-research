# 暗网检索引擎块 —— 合入 searxng/settings.yml 的 `engines:` 段落
#
# name 必须与 diagnostics/engine_health.py 的 DARKWEB_ENGINES 逐字一致,
# 否则连接测试的 L2 级会误报"引擎未合入"。
#
# socks5h 的 h 表示由 Tor 做 DNS 解析 —— .onion 域名无法经普通 DNS 解析,
# 用 socks5（无 h）会直接失败。
  - name: ahmia
    engine: ahmia
    using_tor_proxy: true
    timeout: 40.0
    proxies:
      all://: socks5h://ldr-tor:9050

  - name: torch
    engine: xpath
    using_tor_proxy: true
    timeout: 40.0
    paging: true
    proxies:
      all://: socks5h://ldr-tor:9050
    search_url: http://xmh57jrknzkhv6y3ls3ubitzfqnkrwxhopf5aygthi7d6rplyvk3noyd.onion/cgi-bin/omega/omega?P={query}&DEFAULTOP=and
    results_xpath: //table//tr
    url_xpath: ./td[2]/a
    title_xpath: ./td[2]/b
    content_xpath: ./td[2]/small

  - name: vormweb
    # VormWeb indexes .onion sites and exposes both a clearnet
    # endpoint (vormweb.com) and a .onion mirror. Clearnet is fine
    # for the search call; only the indexed results are .onion links
    # (which is what the user actually wants from a dark-web engine).
    # using_tor_proxy=False because the clearnet endpoint is faster
    # and not blocked from this container. If vormweb.com goes
    # down, switch to the .onion URL by changing search_url +
    # using_tor_proxy=True.
    engine: xpath
    timeout: 30.0
    paging: true
    search_url: https://vormweb.com/search?q={query}&page={pageno}
    results_xpath: //div[contains(@class,"result")] | //li[contains(@class,"result")]
    url_xpath: .//a[@class="result-link"]/@href | .//h3/a/@href
    title_xpath: .//h3 | .//a[@class="result-title"]
    content_xpath: .//p[@class="result-snippet"] | .//div[contains(@class,"snippet")]
